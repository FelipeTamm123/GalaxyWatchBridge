<?xml version="1.0" encoding="utf-8"?>
<!--
  Merge these into the Wear OS module's AndroidManifest.xml.

  The permission split at API 31 (Android 12) is the usual stumbling block: the old
  BLUETOOTH / BLUETOOTH_ADMIN pair was replaced by granular runtime permissions, and
  BLUETOOTH_ADVERTISE must be REQUESTED AT RUNTIME — declaring it here is not enough.
  Galaxy Watch 4 and later all run API 30+, so in practice you always need the new ones.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- API 31+ runtime permissions. Request BLUETOOTH_ADVERTISE and BLUETOOTH_CONNECT
         with ActivityResultContracts.RequestMultiplePermissions before starting the
         service, or openGattServer returns null and advertising silently fails. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Legacy equivalents, for API 30 and below. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Only if you wire up real sensors in readSensors(). -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Required to run the GATT server as a foreground service on API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Peripheral role is not universal. Marking it required keeps the app off hardware
         that cannot advertise, where it would install and then never work. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application>
        <service
            android:name=".GattServerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
