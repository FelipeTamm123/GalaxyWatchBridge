# This repo is authored on Windows and built on a macOS CI runner, so line endings must
# not depend on whoever cloned it. Normalise everything to LF in the repository; Git still
# checks out CRLF locally if core.autocrlf says so.
* text=auto eol=lf

# Shell and YAML break outright if they reach a Unix runner with CRLF.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Xcode's pbxproj is generated by XcodeGen and gitignored, but if it ever gets committed
# it must stay LF or Xcode rewrites the whole file on first open.
*.pbxproj text eol=lf

# Binary — never touch.
*.png binary
*.jpg binary
*.pdf binary
*.ipa binary
*.apk binary
*.jar binary
