<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  REQUIRED on iOS 13+. Omitting this key does not produce a build error or a runtime
	  exception - the app simply crashes the first time CBCentralManager is instantiated,
	  with a console message about a missing usage description. It is the single most
	  common cause of "my BLE app dies on launch".

	  The string is shown verbatim in the system permission prompt, so it must state a
	  concrete reason. App Review rejects generic text like "This app uses Bluetooth".
	-->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This app uses Bluetooth to connect to your watch and read heart rate, step, and battery data.</string>

	<!--
	  Deprecated in iOS 13 but still read by iOS 12 and earlier. Harmless to keep, and the
	  only way to support those releases.
	-->
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>This app uses Bluetooth to connect to your watch and read heart rate, step, and battery data.</string>

	<!--
	  Background BLE. Required if you pass CBCentralManagerOptionRestoreIdentifierKey
	  (see BLEManager.init(enableStateRestoration:)) or want to keep receiving
	  notifications while backgrounded.

	  Two constraints apply once backgrounded, and both surprise people:
	    1. Only FILTERED scans work. scanForPeripherals(withServices: nil) silently returns
	       nothing in the background - you must pass explicit service UUIDs.
	    2. CBCentralManagerScanOptionAllowDuplicatesKey is ignored, so live RSSI stops
	       updating.

	  Remove this whole key if the app has no background requirement - declaring an unused
	  background mode is an App Review rejection reason.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>

	<!--
	  BLE requires physical hardware. This prevents installation on devices without it and
	  keeps the app off the Simulator, where CoreBluetooth reports .unsupported forever.
	-->
	<!--
	  BLE requires physical hardware, so this keeps the app off devices without a radio.

	  Do NOT add an architecture here. The old boilerplate `armv7` entry is actively
	  harmful now: modern iPhones are arm64-only and do not report an armv7 capability, so
	  iOS rejects the install as incompatible. The binary's own architecture already
	  constrains where it can run.
	-->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>bluetooth-le</string>
	</array>

	<!--
	  Bundle identity. These MUST be here.

	  With GENERATE_INFOPLIST_FILE=NO, Xcode injects only build-derived keys
	  (MinimumOSVersion, DTPlatformName, …) and does NOT supply the identity keys the way
	  it does for a synthesised plist. Omitting CFBundleIdentifier still builds and still
	  packages into an .ipa without any warning — the app is simply uninstallable, failing
	  with "Missing bundle ID" only at install time.

	  The $(…) values are substituted from build settings during packaging, so the bundle
	  ID stays defined in one place (project.yml) rather than duplicated here.
	-->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>Watch Bridge</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
